#!/usr/bin/env bash
set -euo pipefail

CONTAINER="${CCA_DSH_CONTAINER:-cca-dsh-sandbox}"
IMAGE="${CCA_DSH_IMAGE:-ghcr.io/converge-ai-labs/a13n-sandbox:0.3.0}"
WORKSPACE_HOST="${CCA_DSH_WORKSPACE:-$HOME/cca-workspaces/default}"
HELPER_HOST="${CCA_DSH_HELPER:-$HOME/cca-dsh/helper}"
SOCKET_HOST="${CCA_DSH_SOCKET_DIR:-/tmp/cca-dsh-sockets}"
HELPER_ENTRY="$HELPER_HOST/node_modules/@deepseek-ai/dsh-ssh/lib/helper.js"
LOCK_FILE="$HOME/cca-dsh/ensure.lock"

if [ ! -x /usr/bin/flock ]; then
  echo "cca-dsh gateway: missing flock" >&2
  exit 1
fi
mkdir -p "$WORKSPACE_HOST" "$SOCKET_HOST"
chmod 700 "$SOCKET_HOST"

mkdir -p "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
flock -x 9

running="$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null || true)"
if [ "$running" != "true" ]; then
  if docker inspect "$CONTAINER" >/dev/null 2>&1; then
    docker start "$CONTAINER" >/dev/null
  else
    docker run -d \
      --name "$CONTAINER" \
      --label cca.dsh.sandbox=true \
      --init \
      --user 1000:1000 \
      --cap-drop ALL \
      --security-opt no-new-privileges \
      --memory 4g \
      --cpus 2 \
      --pids-limit 512 \
      --workdir /workspace \
      -v "$WORKSPACE_HOST:/workspace" \
      -v "$SOCKET_HOST:$SOCKET_HOST" \
      -v "$HELPER_HOST:$HELPER_HOST:ro" \
      "$IMAGE" \
      /bin/sh -c 'trap "exit 0" TERM INT; while :; do sleep 3600; done' >/dev/null
  fi
fi

exec docker exec -i \
  -e DSH_SSH_TMPDIR="$SOCKET_HOST" \
  "$CONTAINER" \
  /usr/local/bin/node --disable-sigusr1 "$HELPER_ENTRY"
