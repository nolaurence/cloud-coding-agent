# 宿主机端口;容器内部固定使用 8787
APP_PORT=7001

# Agent 可访问的宿主机代码目录
WORKSPACE_DIR=./workspace

# 外部 MySQL,生产 Compose 不会启动数据库容器;密码中的 URL 保留字符需要百分号编码
DATABASE_URL=mysql://user:password@mysql.example.com:3306/cloud_coding_agent

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public URL used by CCA and the embedded DeepSeek Harness reverse proxy.
CCA_PUBLIC_URL=http://192.168.100.241:7001

# DeepSeek Harness uses CCA's left navigation and the DSH web UI in the main area.
DSH_ENABLED=true
DSH_SANDBOX_ENABLED=true
DSH_SANDBOX_SSH_HOST=192.168.100.130
DSH_SANDBOX_SSH_USER=nolaurence
# Generated during sandbox provisioning and stored in the agent-data volume.
DSH_SANDBOX_SSH_KEY=/data/dsh-home-cca/.ssh/cca_sandbox_ed25519
DSH_SANDBOX_WORKSPACE=/workspace
DSH_SANDBOX_SYNC_ENABLED=true
# Generated during sandbox provisioning; restricted with rrsync on the sandbox host.
DSH_SANDBOX_SYNC_KEY=/data/dsh-home-cca/.ssh/cca_workspace_sync_ed25519
DSH_SANDBOX_HOST_WORKSPACE=/home/nolaurence/cca-workspaces/default
