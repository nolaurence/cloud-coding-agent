# 宿主机端口;容器内部固定使用 8787
APP_PORT=7001

# Agent 可访问的宿主机代码目录
WORKSPACE_DIR=./workspace

# 使用远端 Docker 沙箱时启用。配置文件及 sandbox-ssh/ 密钥目录须预先放入 /data 卷。
# 显式指定后，配置缺失或连接失败会报错，不回退本地执行。
# CCA_DOCKER_SANDBOX_CONFIG=/data/docker-sandbox.json

# 外部 MySQL,生产 Compose 不会启动数据库容器;密码中的 URL 保留字符需要百分号编码
DATABASE_URL=mysql://user:password@mysql.example.com:3306/cloud_coding_agent

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
