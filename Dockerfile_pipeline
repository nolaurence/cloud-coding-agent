FROM node:22-slim AS deps
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3 \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/protocol/package.json packages/protocol/
RUN npm ci --no-audit --no-fund

FROM deps AS server-build
COPY tsconfig.base.json ./
COPY apps/server ./apps/server
COPY apps/desktop/build-server.mjs ./apps/desktop/build-server.mjs
COPY packages/protocol ./packages/protocol
RUN npm run build -w @cca/server

FROM node:22-slim
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8787
ENV CCA_DATA_DIR=/data

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/server ./apps/server
COPY --from=server-build /app/apps/server/dist ./apps/server/dist
COPY packages/protocol ./packages/protocol
COPY apps/web/package.json ./apps/web/package.json
COPY apps/web/dist ./apps/web/dist

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium fonts-noto-cjk git openssh-client bubblewrap novnc ripgrep websockify x11vnc xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data \
    && git config --system --add safe.directory '*'

EXPOSE 8787
VOLUME ["/data"]
CMD ["npm", "run", "start", "-w", "@cca/server"]

