{
  "name": "@cca/dsh-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vendored DeepSeek Harness web shell: boots the official DSH client plugin graph with the CCA host-injected boot manifest.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:plugins && vite build",
    "build:plugins": "node scripts/build-plugins.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:plugins",
    "typecheck:plugins": "tsc -p plugins/tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-web": "0.2.1-rc.2",
    "@shikijs/langs": "^4.4.3",
    "@tanstack/react-virtual": "3.14.10",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "immer": "^10.1.1",
    "katex": "^0.18.7",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.4.3",
    "simple-icons": "16.31.0",
    "zod": "4.4.3",
    "zustand": "~4.5.7"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.0.0",
    "esbuild": "^0.25.12",
    "lightningcss": "^1.33.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.0"
  }
